# KNOWHERE-MAIN style dual endpoints (copy to llm_api.env and fill).
# Qwen / embeddings → DashScope
ALI_API_KEYS=
ALI_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek → official API
DS_KEY=
DS_URL=https://api.deepseek.com/v1

# Defaults used when model family is neither qwen nor deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

COMPOSE_MODEL=qwen3.5-flash
NAV_LLM_MODEL=qwen3.5-flash
JUDGE_MODEL=deepseek-v4-pro
BODYRICH_EMBEDDING_BACKEND=remote
BODYRICH_EMBEDDING_MODEL=text-embedding-v3
