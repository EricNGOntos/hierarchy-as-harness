OPENAI_API_KEY=
OPENAI_BASE_URL=
COMPOSE_MODEL=qwen3.5-flash
JUDGE_MODEL=qwen3.5-flash
NAV_LLM_MODEL=qwen3.5-flash
TREERAG_MODEL=qwen3.5-flash
OPENAI_VERIFY_SSL=0
OPENAI_TRUST_ENV=0

# Dense retrieval (remote; no local GPU)
BODYRICH_EMBEDDING_BACKEND=remote
BODYRICH_EMBEDDING_MODEL=text-embedding-v3
BODYRICH_EMBEDDING_CACHE=1
BODYRICH_EMBEDDING_CACHE_DIR=cache/embeddings_remote
BODYRICH_QUERY_EMBEDDING_CACHE=1
BODYRICH_EMBEDDING_BATCH_SIZE=10
