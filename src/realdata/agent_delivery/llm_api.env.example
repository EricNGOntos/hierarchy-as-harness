OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.zhizengzeng.com/v1
# Optional DeepSeek-native credentials (used when NAV_PLANNER_MODEL starts with deepseek*).
# DS_KEY=
# DS_URL=https://api.deepseek.com/v1
COMPOSE_MODEL=qwen3.5-flash
JUDGE_MODEL=deepseek-v4-pro
NAV_LLM_MODEL=qwen3.5-flash
TREERAG_MODEL=qwen3.5-flash
# Query planner (structure-conditioned). Prefer deepseek-v4-flash + DS_KEY.
# NAV_PLANNER_MODEL=deepseek-v4-flash
# NAV_PLANNER_THINKING=disabled
# # think mode: reasoning shares max_tokens with final JSON — keep this large
# NAV_PLANNER_THINK_MAX_TOKENS=16384
# NAV_PLANNER_REASONING_EFFORT=high
# NAV_PLANNER_TIMEOUT_SECONDS=300
OPENAI_VERIFY_SSL=0
OPENAI_TRUST_ENV=0
BODYRICH_EMBEDDING_BACKEND=remote
BODYRICH_EMBEDDING_MODEL=text-embedding-v3
